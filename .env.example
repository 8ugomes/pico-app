# Copie para .env.local e preencha com as credenciais públicas do seu projeto.
# Nunca use uma secret key ou service_role em variáveis NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exclusivo do servidor: upload validado e exclusão da conta autenticada.
# Nunca use o prefixo NEXT_PUBLIC_ para este valor.
SUPABASE_SECRET_KEY=
