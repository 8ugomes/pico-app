# Explicit demo: NEXT_PUBLIC_PICO_ENV=demo and omit all Supabase keys.
# Development uses only its exclusive project. Never copy beta secrets here.
NEXT_PUBLIC_PICO_ENV=development
PICO_ENV=development
PICO_PROJECT_REF=tsebpkfnxjvhntosbkdu
NEXT_PUBLIC_SUPABASE_URL=https://tsebpkfnxjvhntosbkdu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; protected environment storage, never NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
# Optional verified public privacy contact; do not invent a value.
NEXT_PUBLIC_PRIVACY_CONTACT=
# Public name of the actual controller; never invent a legal entity.
NEXT_PUBLIC_PRIVACY_CONTROLLER=
# Enable only AFTER the provider accepts the versioned custom templates.
# Default provider on Supabase Free currently rejects template modifications.
# NEXT_PUBLIC_PICO_EMAIL_TEMPLATES=custom
# Messages stay off until this flag AND pico_private.direct_messages_settings are enabled.
PICO_DIRECT_MESSAGES_ENABLED=false
# Push stays off until BOTH this flag and pico_private.push_settings are enabled.
# Generate VAPID credentials privately; these placeholders never send anything.
PICO_WEB_PUSH_ENABLED=false
PICO_VAPID_PUBLIC_KEY=
PICO_VAPID_PRIVATE_KEY=
PICO_VAPID_SUBJECT=
# At least 32 random characters; server-only bearer for POST /api/push/dispatch.
PICO_PUSH_DISPATCH_SECRET=
# Canonical HTTPS origin used for share links and release associations.
# Local development may explicitly use http://localhost:<port>.
PICO_PUBLIC_ORIGIN=
# Collection also requires the private database gate, approved retention and a
# monitored five-minute heartbeat (`npm run metrics:heartbeat`).
PICO_PRODUCT_MEASUREMENT_ENABLED=false
# At least 32 random characters; authenticates only the deployed heartbeat endpoint.
PICO_PRODUCT_MEASUREMENT_HEARTBEAT_SECRET=
# Separate executor gate for the monitored retention job. This does not enable collection.
PICO_PRODUCT_MEASUREMENT_PURGE_ENABLED=false
