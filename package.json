{
  "name": "picoapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "node --env-file=.env.beta.local --env-file=.env.beta-admin scripts/deploy.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "measure:css": "node scripts/measure-route-css.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:db": "node --test tests/database.test.mjs",
    "test:hosted": "node --env-file=.env.local --env-file=.env.hosted-admin scripts/guarded-hosted-test.mjs",
    "native:doctor": "node scripts/native-doctor.mjs",
    "native:assets": "node scripts/generate-native-assets.mjs",
    "mobile:build": "node scripts/build-mobile.mjs",
    "native:sync": "cap sync",
    "native:sync:ios": "npm run mobile:build && cap sync ios",
    "native:preflight:ios": "node scripts/ios-release-preflight.mjs",
    "native:verify": "node --test tests/native-package.test.mjs && npm run native:sync:ios && node scripts/verify-native-sync.mjs",
    "native:build:ios": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build/native-ios -onlyUsePackageVersionsFromResolvedFile CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO build",
    "native:open:ios": "cap open ios",
    "native:open:android": "cap open android",
    "db:types": "node --env-file=.env.local scripts/generate-database-types.mjs",
    "env:check": "node --env-file=.env.local scripts/environment-guard.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "heic-to": "1.5.2",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "6.2.3",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
